# Leader Club Vogtois (LCV) - Optimization & Security Rules for cPanel (Apache)

# Enable Rewrite Engine
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS Security
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # 1. URL Rewriting : Alias / Accès direct (ex: /accueil -> index.php)
  RewriteRule ^accueil/?$ index.php [NC,L]
  RewriteRule ^organisation/?$ about.php [NC,L]
  RewriteRule ^actions/?$ actions.php [NC,L]
  RewriteRule ^galerie/?$ gallery.php [NC,L]
  RewriteRule ^rejoindre/?$ contact.php?form=join [NC,L]
  RewriteRule ^partenaire/?$ contact.php?form=partner [NC,L]
  RewriteRule ^don/?$ donate.php [NC,L]
  RewriteRule ^merci/?$ thank-you.php [NC,L]

  # 2. Redirection 301 automatique si l'utilisateur saisit directement .php dans le navigateur
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^/]+)\.php\ HTTP/
  RewriteRule ^([^/]+)\.php$ /$1 [R=301,L]

  # 3. URL Rewriting Générique : /nom-de-page vers nom-de-page.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.php -f
  RewriteRule ^([a-zA-Z0-9_-]+)/?$ $1.php [NC,L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Gzip Compression for Fast Page Load Speed
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Browser Caching Policy
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresDefault "access plus 2 days"
</IfModule>

# Prevent Directory Browsing
Options -Indexes
